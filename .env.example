BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_FROM=
FRONTEND_URL=
# Extra browser origins allowed to call the API, comma separated (e.g. the www. version of the site).
CORS_ORIGINS=
APP_URL=
GEMINI_API_KEY=
# Long random string. Required in production: without it sign-in tokens can be forged.
JWT_SECRET=
MONGODB_URI=
PORT=3000
NODE_ENV=production
R2_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=
R2_SECRET_KEY=
SMS_API_KEY=
SMS_PROVIDER=
SMS_SENDER_ID=
VITE_API_URL=

# Signs the QR code on student and staff ID cards (scan-to-mark attendance).
# Set once and keep it: changing it makes every printed card's QR invalid.
# If unset, a key is derived from JWT_SECRET.
ID_CARD_QR_SECRET=

# PhonePe Payment Gateway (Standard Checkout) — server only, never put these in the website or the mobile app.
# Credentials: PhonePe Business Dashboard → Developer Settings → API Keys (Client ID, Client Secret, Client Version).
# PHONEPE_ENV picks the set: sandbox (default, Test Mode ON in the dashboard) or production (Test Mode OFF).
PHONEPE_ENV=sandbox
PHONEPE_SANDBOX_CLIENT_ID=
PHONEPE_SANDBOX_CLIENT_SECRET=
PHONEPE_SANDBOX_CLIENT_VERSION=1
PHONEPE_PROD_CLIENT_ID=
PHONEPE_PROD_CLIENT_SECRET=
PHONEPE_PROD_CLIENT_VERSION=1
# Webhook (Dashboard → Developer Settings → Webhook → Create Webhook), for the active environment:
#   Authentication "SHA": the Username and Password you type there
PHONEPE_SANDBOX_WEBHOOK_USERNAME=
PHONEPE_SANDBOX_WEBHOOK_PASSWORD=
PHONEPE_PROD_WEBHOOK_USERNAME=
PHONEPE_PROD_WEBHOOK_PASSWORD=
#   Authentication "HMAC": the Secret Key the dashboard generates (use this OR the username/password)
PHONEPE_SANDBOX_WEBHOOK_HMAC_SECRET=
PHONEPE_PROD_WEBHOOK_HMAC_SECRET=
# Optional: public address PhonePe sends the payer back to (defaults to PUBLIC_SITE_URL, else this request's host)
# PHONEPE_RETURN_BASE_URL=https://residentialpdsschool.in

# --- Push notifications ---------------------------------------------------------------------------
# Browser notifications (Web Push). Create the pair once with:  npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY secret. Without these two, browser alerts stay off (phone alerts are unaffected).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:school@example.com
# Phone notifications (Android) go straight through Firebase Cloud Messaging, no Expo account needed.
# Firebase console > Project settings > Service accounts > Generate new private key. Put the WHOLE json here on one
# line, or its base64 (base64 -w0 key.json). Secret: never commit it and never paste it in chat.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional, only for old Expo-token phones: an Expo access token ("enhanced push security").
EXPO_ACCESS_TOKEN=
# Test only, never in production: write pushes to this file instead of sending them.
# PUSH_RECORD_FILE=

# First admin account. Only used when the database has no admin yet; an existing password is never reset.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PHONE=
# Starting password for new staff / parent accounts created without one. If empty, they need a password reset.
DEFAULT_USER_PASSWORD=
# One-time fix: set to true, restart once, then REMOVE it. Sets the existing main admin's password
# (and phone/email/name, if given above) from INITIAL_ADMIN_*. Left on, every restart resets it.
RESET_ADMIN_PASSWORD_ON_START=
# Only to deliberately import the sample data in data/*.json into an empty database. Never in production.
ALLOW_JSON_SEED=
