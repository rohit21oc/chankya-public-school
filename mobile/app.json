{
  "expo": {
    "name": "CHANAKYA PUBLIC SCHOOL & COACHING CENTRE",
    "slug": "chanakyapublicschool",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.chanakyapublicschool.app",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to scan student and staff ID cards to mark attendance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "in.chanakyapublicschool.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],

            "versionCode": 5,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "schoolName": "CHANAKYA PUBLIC SCHOOL & COACHING CENTRE",
      "cbseAffiliation": "10034104008",
      "schoolCode": "CPS-KSH",
      "productionApiUrl": "https://set-your-backend-url.example"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan student and staff ID cards to mark attendance.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B1F4B",
          "defaultChannel": "school-alerts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo from your gallery to use as your profile picture.",
          "cameraPermission": "The camera is used to scan student and staff ID cards to mark attendance.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "runtimeVersion": "1.0.1",
    "updates": {
      "enabled": false
    }
  }
}