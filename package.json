    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "html2canvas-pro": "^2.4.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.2",
    "motion": "^12.43.0",
    "nodemailer": "^10.0.10",
    "pdfjs-dist": "4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
