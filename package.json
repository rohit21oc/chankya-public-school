    "verify:operations": "tsx scripts/verify-operations-modules.ts",
    "verify:fee-settlement": "tsx scripts/verify-fee-settlement.ts",
    "verify:payment-rules": "tsx scripts/verify-online-payment-rules.ts",
    "verify:phonepe-api": "node scripts/verify-phonepe-payments.mjs",
    "verify:no-dev-seed": "tsx scripts/verify-no-dev-seed.ts",
